

generator client {
  provider = "prisma-client-js"
}

// Datasource obrigatória, mas URL não é usada no Prisma 7
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task { 
  id    Int     @id @default(autoincrement()) 
  title String 
  completed  Boolean @default(false)
  priority String
}